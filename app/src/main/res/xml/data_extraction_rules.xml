<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing is backed up or transferred: restored alarms would not be scheduled until the app is opened. -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="root" />
        <exclude domain="device" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="device" />
    </device-transfer>
</data-extraction-rules>
