    <string name="onboarding_title">Let\'s make sure it rings.</string>
    <string name="health_title">Alarm health</string>
    <string name="health_intro">Phones love to silence apps to save battery. Each orange dot is a way your alarm could stay quiet.</string>
    <string name="h_notifications">Notifications</string>
    <string name="h_notifications_text">Without them Android hides the alarm screen.</string>
    <string name="h_fullscreen">Full-screen alarm</string>
    <string name="h_fullscreen_text">Lets the alarm take over a locked screen.</string>
    <string name="h_exact">Exact alarms</string>
    <string name="h_exact_text">Without it Android may ring minutes late.</string>
    <string name="h_battery">No battery limits</string>
    <string name="h_battery_text">Battery saving can kill the alarm before it rings. Pick \"Don\'t optimize\" or \"Unrestricted\".</string>
    <string name="h_vendor">Phone maker\'s restrictions</string>
    <string name="h_vendor_text">Many phones add their own switches on top of Android. On the app page allow everything you find: autostart, show on lock screen, pop-up windows in the background, no battery restrictions. The phone cannot tell us, so mark it yourself.</string>
    <string name="h_vendor_guide">Guide for this phone</string>
