    <string name="h_vendor_undo">Not done yet</string>
    <string name="h_camera">Camera</string>
    <string name="h_camera_text">For QR codes. Better to allow it now than half asleep.</string>
    <string name="h_watch_text">The alarm notification has no buttons, so a watch can show it but cannot stop it.</string>
